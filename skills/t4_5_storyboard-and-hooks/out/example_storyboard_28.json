{
  "id": "example_28_chatbot",
  "title": "What does AI actually do?",
  "format": 28,
  "brand": "bgi",
  "fps": 30,
  "cover": {
    "t": 1.3
  },
  "hook": {
    "pattern": "question",
    "l1": "What does AI",
    "l2": "actually do?"
  },
  "beats": [
    {
      "id": "hook",
      "kind": "hook",
      "dur": 2.4,
      "text": "What does AI actually do?",
      "voice": "What does AI actually do?",
      "visual": "a chat bubble pops in with a blinking cursor",
      "events": [
        1
      ],
      "openLoop": true
    },
    {
      "id": "problem",
      "kind": "setup",
      "dur": 4.6,
      "text": "It writes fluent answers.",
      "voice": "It writes smooth, confident answers. But how?",
      "visual": "a window: a question types in and a long answer streams out",
      "events": [
        0.9,
        2.2,
        3.5
      ]
    },
    {
      "id": "reveal",
      "kind": "reveal",
      "dur": 7,
      "text": "It predicts the next word.",
      "voice": "Given some text, it predicts the word that is most likely to come next. Then it repeats.",
      "visual": "a sentence grows word by word with candidate chips",
      "events": [
        1.2,
        2.6,
        4,
        5.4
      ]
    },
    {
      "id": "proof",
      "kind": "proof",
      "dur": 6,
      "text": "One word at a time.",
      "voice": "The capital of France is. Paris scores high. Other words score near zero.",
      "visual": "probability bars fill, Paris wins",
      "events": [
        1,
        2.2,
        3.6,
        4.8
      ]
    },
    {
      "id": "payoff",
      "kind": "payoff",
      "dur": 4.9,
      "text": "Fluent is not the same as true.",
      "voice": "That is why a fluent answer can still be wrong. Check what matters.",
      "visual": "a stamp slams: CHECK IT",
      "events": [
        0.6,
        1.9,
        3.3
      ],
      "closeLoop": true
    }
  ]
}